# Copie para .env e preencha. Nunca versione valores reais.

# PostgreSQL 16+ com extensões unaccent e pg_trgm (criadas pela migração).
DATABASE_URL=postgres://contexto:contexto@localhost:5432/contexto

# Provedor de IA: "anthropic" ou "none".
# Com "none", o assistente funciona em modo somente-evidências (sem texto gerado).
AI_PROVIDER=none
ANTHROPIC_API_KEY=
# Modelo usado nas explicações e no assistente.
AI_MODEL=claude-opus-5-5
# Limite diário de chamadas ao modelo (todas as pessoas somadas). 0 = bloqueia.
AI_DAILY_CALL_LIMIT=500
# Limite por IP/sessão por hora no assistente.
AI_HOURLY_LIMIT_PER_CLIENT=30

# Segredo que protege a rota /api/cron/ingest (header Authorization: Bearer <valor>).
CRON_SECRET=

# E-mails com papel de administrador (separados por vírgula).
ADMIN_EMAILS=

# Diretório para documentos brutos preservados quando a licença permite.
RAW_STORAGE_DIR=./data/raw
